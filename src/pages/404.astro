---
import Base from '../layouts/Base.astro';
import { allViews, u, t } from '../lib/site';
const view = allViews()[0];
const [first, ...rest] = t('not_found_title', view.role).split(' ');
---
<Base view={view} title="Not found" path="">
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">404 · Page not found</span>
      <h1><span class="hl">{first}</span> {rest.join(' ')}</h1>
      <p class="lead">{t('not_found_lead', view.role)}</p>
      <a class="btn primary" href={u('')}>Back home</a>
    </div>
  </section>
</Base>
