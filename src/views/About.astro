---
import { getEntry, render } from 'astro:content';
import { cfg, u, t, type View } from '../lib/site';

interface Props { view: View }
const { view } = Astro.props;
const page = await getEntry('pages', 'about');
const rendered = page ? await render(page) : null;
---
<div class="wrap">
  <header class="page-head">
    <span class="eyebrow">About</span>
    <h1>{page?.data.title ?? t('about_title', view.role)}</h1>
    <p>{cfg.tagline}</p>
  </header>
  <div class="article-layout" style="margin-bottom:72px">
    <div class="prose">{rendered && <rendered.Content />}</div>
    <aside class="article-aside">
      {cfg.avatar && <img class="avatar" style="width:100%;height:auto;transform:none" src={u(cfg.avatar)} alt={cfg.name} />}
      <div class="aside-box">
        <h4>Contact</h4>
        <dl>
          {cfg.email && <><dt>Email</dt><dd><a href={`mailto:${cfg.email}`}>{cfg.email}</a></dd></>}
          {cfg.location && <><dt>Based in</dt><dd>{cfg.location}</dd></>}
          {cfg.links.map((l: any) => <><dt>{l.label}</dt><dd><a href={l.url} target="_blank" rel="me noopener">{l.url.replace(/^https?:\/\/(www\.)?/, '')}</a></dd></>)}
        </dl>
      </div>
      <div class="aside-box">
        <h4>Currently</h4>
        <p style="margin:0">{view.role.cta || cfg.availability}</p>
      </div>
    </aside>
  </div>
</div>
