---
import ItemCard from '../components/ItemCard.astro';
import ItemRow from '../components/ItemRow.astro';
import TagFilter from '../components/TagFilter.astro';
import { itemsFor, t, type View } from '../lib/site';

interface Props { view: View; kind: 'projects' | 'debug' | 'blog' }
const { view, kind } = Astro.props;
const role = view.role;

const copy = {
  projects: {
    eyebrow: '◆ Projects', title: t('projects_title', role), lead: t('projects_lead', role),
    types: ['project'] as const,
  },
  debug: {
    eyebrow: '⌁ Debug Diary', title: t('debug_title', role), lead: t('debug_lead', role),
    types: ['debug'] as const,
  },
  blog: {
    eyebrow: '¶ Writing', title: t('blog_title', role), lead: t('blog_lead', role),
    types: ['post', 'til'] as const,
  },
}[kind];

const items = await itemsFor(role, [...copy.types]);
---
<div class="wrap">
  <header class="page-head">
    <span class="eyebrow">{copy.eyebrow}</span>
    <h1>{copy.title}</h1>
    <p>{copy.lead}</p>
  </header>

  <TagFilter items={items} target="#list" />

  {items.length === 0 && <p class="muted">Nothing here for the {role.label} view yet.</p>}

  {kind === 'blog'
    ? <div class="rows" id="list" style="margin-bottom:72px">{items.map((i) => <ItemRow item={i} view={view} />)}</div>
    : <div class="grid" id="list" style="margin-bottom:72px">{items.map((i) => <ItemCard item={i} view={view} featured={i.data.featured.includes(role.id)} />)}</div>}
</div>
