---
import { cfg, u, experienceFor, highlightsFor, displayCompany, fmtDate, itemsFor, itemUrl, safeText, prettyTag, type View } from '../lib/site';

interface Props { view: View }
const { view } = Astro.props;
const role = view.role;
const jobs = await experienceFor(role);
const projects = (await itemsFor(role, 'project')).slice(0, 4);
const site = new URL(u(view.prefix), Astro.site).toString().replace(/^https?:\/\//, '');
---
<div class="wrap">
  <div class="resume-toolbar">
    {role.resume_pdf
      ? <a class="btn primary" href={u(role.resume_pdf)} download>Download PDF</a>
      : <button class="btn primary" onclick="window.print()">Print / Save as PDF</button>}
    <span class="pill">Tailored for <b style="color:var(--accent)">&nbsp;{role.label}</b></span>
  </div>

  <article class="resume">
    <header>
      <h1>{cfg.name}</h1>
      <div class="role-line">{role.label}</div>
      <div class="contact">
        {cfg.location && <span>{cfg.location}</span>}
        {cfg.email && <a href={`mailto:${cfg.email}`}>{cfg.email}</a>}
        <a href={u(view.prefix)}>{site}</a>
        {cfg.links.map((l: any) => <a href={l.url}>{l.label}</a>)}
      </div>
    </header>

    <h2>Summary</h2>
    <p style="margin:0">{role.summary}</p>

    {role.skills_highlight.length > 0 && (<>
      <h2>Core skills</h2>
      <p style="margin:0">{role.skills_highlight.map(prettyTag).join(' · ')}</p>
    </>)}

    {jobs.length > 0 && (<>
      <h2>Experience</h2>
      {jobs.map((j) => (
        <div class="job">
          <div class="job-head">
            <b>{j.data.title} — {displayCompany(j.data)}</b>
            <span>{fmtDate(j.data.start, 'short')} – {j.data.end ? fmtDate(j.data.end, 'short') : 'Present'}</span>
          </div>
          <ul>{highlightsFor(j, role).map((h) => <li>{h}</li>)}</ul>
        </div>
      ))}
    </>)}

    {projects.length > 0 && (<>
      <h2>Selected projects</h2>
      {projects.map((p) => (
        <div class="proj">
          <b><a href={itemUrl(p, view)}>{safeText(p.data.title, p.data)}</a></b>
          {p.data.impact && <> — {safeText(p.data.impact, p.data)}</>}
          <div class="muted">{safeText(p.data.summary, p.data)}</div>
        </div>
      ))}
    </>)}
  </article>
</div>
