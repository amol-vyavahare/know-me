---
import { render } from 'astro:content';
import { experienceFor, highlightsFor, displayCompany, fmtDate, itemsFor, itemUrl, safeText, prettyTag, skillId, skillUrl, t, renderMarkdown, type View, type JobData } from '../lib/site';

interface Props { view: View }
const { view } = Astro.props;
const role = view.role;
const jobs = await experienceFor(role);
const items = await itemsFor(role);

const entries = await Promise.all(jobs.map(async (j) => {
  const { Content } = await render(j);
  // A per_role `description` replaces the file's Markdown body for this persona
  const d = j.data as JobData;
  const description = d.description ? await renderMarkdown(safeText(d.description, d)) : undefined;
  const end = j.data.end ?? new Date();
  const written = items.filter((i) => i.data.date >= j.data.start && i.data.date <= end).slice(0, 4);
  return { j, Content, description, written, highlights: highlightsFor(j, role) };
}));
---
<div class="wrap">
  <header class="page-head">
    <span class="eyebrow">Journey</span>
    <h1>{t('journey_title', role)}</h1>
    <p>{t('journey_lead', role)}</p>
  </header>

  <div class="timeline">
    {entries.map(({ j, Content, description, written, highlights }) => (
      <article class="tl-item" id={j.id}>
        <div class="tl-when">{fmtDate(j.data.start, 'short')} — {j.data.end ? fmtDate(j.data.end, 'short') : 'Present'}</div>
        <h3>{j.data.title}</h3>
        <div><span class="tl-co">{displayCompany(j.data)}</span>{j.data.location && <span class="muted"> · {j.data.location}</span>}</div>
        <div class="tl-card">
          {j.data.summary && <p style="margin-top:0">{safeText(j.data.summary, j.data)}</p>}
          {highlights.length > 0 && <ul>{highlights.map((h) => <li>{h}</li>)}</ul>}
          {description
            ? <div class="prose" style="font-size:15px" set:html={description} />
            : <div class="prose" style="font-size:15px"><Content /></div>}
          {j.data.skills.length > 0 && (
            <div class="card-foot" style="margin-top:12px">{j.data.skills.map((s) => {
              const id = skillId(s);
              return id ? <a class="tag" href={skillUrl(id, view)}>{prettyTag(s)}</a> : <span class="tag">{prettyTag(s)}</span>;
            })}</div>
          )}
          {written.length > 0 && (
            <div class="tl-written">
              <span class="eyebrow" style="font-size:10px">Written during this role</span>
              {written.map((w) => <a href={itemUrl(w, view)}>→ {safeText(w.data.title, w.data)}</a>)}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</div>
