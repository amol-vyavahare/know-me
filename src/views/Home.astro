---
import ItemCard from '../components/ItemCard.astro';
import ItemRow from '../components/ItemRow.astro';
import {
  cfg, u, viewUrl, itemsFor, featuredFor, experienceFor, displayCompany, fmtDate,
  yearsOfExperience, prettyTag, TYPE_META, skillsFor, skillId, skillUrl, hasSection, t as text, type View, type ItemType,
} from '../lib/site';

interface Props { view: View }
const { view } = Astro.props;
const role = view.role;

const all = await itemsFor(role);
const featured = await featuredFor(role, 3);
const featuredIds = new Set(featured.map((f) => f.id));
const jobs = await experienceFor(role);
const years = yearsOfExperience();

const count = (t: ItemType) => all.filter((i) => i.data.type === t).length;
const stats = [
  years ? { n: `${years}+`, l: 'years in software' } : null,
  { n: count('project'), l: 'projects shipped' },
  { n: count('debug'), l: 'debug stories' },
  { n: count('post') + count('til'), l: 'articles & learnings' },
].filter(Boolean) as { n: string | number; l: string }[];

// Skills → how many items back each one up (same matching as the Skills pages)
const roleSkills = new Map((await skillsFor(role)).map((s) => [s.id, s]));
const skills = role.skills_highlight.map((s) => {
  const found = roleSkills.get(skillId(s) ?? '');
  return { s, label: found?.label ?? prettyTag(s), n: found?.items.length ?? 0, href: found && skillUrl(found.id, view) };
});

// Sections in the order this persona prefers; posts + TIL share "Writing"
const seen = new Set<string>();
const sections = role.content_priority
  .map((t) => (t === 'til' ? 'post' : t))
  .filter((t) => !seen.has(t) && seen.add(t))
  .map((t) => {
    const types: ItemType[] = t === 'post' ? ['post', 'til'] : [t as ItemType];
    const items = all.filter((i) => types.includes(i.data.type) && !featuredIds.has(i.id)).slice(0, t === 'post' ? 5 : 3);
    const meta = TYPE_META[t as ItemType];
    return { t, items, title: t === 'post' ? text('home_writing_title', role) : meta.plural, section: meta.section };
  })
  .filter((s) => s.items.length);

const email = cfg.email ? `mailto:${cfg.email}` : undefined;
// hide_sections: [journey] → job rows stay, but don't link to the (missing) Journey page
const hasJourney = hasSection(role, 'journey');
const JobRow = hasJourney ? 'a' : 'div';
const [first, ...rest] = role.headline.split(' ');
---
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="hero-meta">
        <span class="pill"><span class="dot"></span> {role.label}</span>
        {cfg.availability && <span class="pill status"><span class="dot"></span>{cfg.availability}</span>}
        {cfg.location && <span class="pill">📍 {cfg.location}</span>}
      </div>
      <h1><span class="hl">{first}</span> {rest.join(' ')}</h1>
      <p class="lead">{role.summary}</p>
      <div class="btn-row">
        {hasSection(role, 'resume') && <a class="btn primary" href={viewUrl(view, 'resume')}>View {role.label} resume →</a>}
        {email && <a class="btn" href={email}>Get in touch</a>}
        {hasJourney && <a class="btn" href={viewUrl(view, 'journey')}>My journey</a>}
      </div>
    </div>
    {cfg.avatar && <img class="avatar" src={u(cfg.avatar)} alt={cfg.name} width="220" height="220" />}
  </div>
</section>

<div class="wrap">
  <div class="stats">
    {stats.map((s) => <div class="stat"><b>{s.n}</b><span>{s.l}</span></div>)}
  </div>
</div>

{featured.length > 0 && (
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Start here</span><h2>{text('home_featured_title', role)}</h2></div>
      </div>
      <div class="grid">
        {featured.map((i) => <ItemCard item={i} view={view} featured />)}
      </div>
    </div>
  </section>
)}

{skills.length > 0 && (
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Toolkit</span><h2>{text('home_skills_title', role)}</h2></div>
        <a href={viewUrl(view, 'skills')}>All skills →</a>
      </div>
      <div class="skills">
        {skills.map(({ label, n, href }) => {
          const inner = <>{label}{n > 0 && <small>{n} {n === 1 ? 'story' : 'stories'}</small>}</>;
          return href ? <a class="skill" href={href}>{inner}</a> : <span class="skill">{inner}</span>;
        })}
      </div>
    </div>
  </section>
)}

{sections.map((sec) => (
  <section class="section" style="padding-top:8px">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">{TYPE_META[sec.t as ItemType].icon} Latest</span><h2>{sec.title}</h2></div>
        <a href={viewUrl(view, sec.section)}>See all →</a>
      </div>
      {sec.t === 'post'
        ? <div class="rows">{sec.items.map((i) => <ItemRow item={i} view={view} />)}</div>
        : <div class="grid">{sec.items.map((i) => <ItemCard item={i} view={view} />)}</div>}
    </div>
  </section>
))}

{jobs.length > 0 && (
  <section class="section" style="padding-top:8px">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Journey</span><h2>{text('home_journey_title', role)}</h2></div>
        {hasJourney && <a href={viewUrl(view, 'journey')}>Full timeline →</a>}
      </div>
      <div class="rows">
        {jobs.slice(0, 4).map((j) => (
          <JobRow class="row" href={hasJourney ? viewUrl(view, 'journey') + '#' + j.id : undefined}>
            <time>{fmtDate(j.data.start, 'short')}</time>
            <div><h3>{j.data.title}</h3><p>{displayCompany(j.data)}{j.data.location && ` · ${j.data.location}`}</p></div>
            <span class="tag">{j.data.end ? fmtDate(j.data.end, 'short') : 'Present'}</span>
          </JobRow>
        ))}
      </div>
    </div>
  </section>
)}

<div class="wrap">
  <div class="cta-band">
    <div>
      <h2>{role.cta || text('home_cta_title', role)}</h2>
      <p>{text('home_cta_text', role)}</p>
    </div>
    <div class="btn-row">
      {email && <a class="btn primary" href={email}>Email me</a>}
      {cfg.links.slice(0, 2).map((l: any) => <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label}</a>)}
    </div>
  </div>
</div>
